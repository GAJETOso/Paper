# ============================================================================
# Production image for Node TS services (bots, chatbot, portals, services).
#   docker build -f docker/Dockerfile.service --build-arg APP=whatsapp-bot .
# Runs TypeScript directly via Node's type stripping — no build step.
# ============================================================================
ARG APP=whatsapp-bot

FROM node:26-alpine
ARG APP
ENV NODE_ENV=production APP_NAME=@sylvara/${APP}
# Node 26's alpine image no longer bundles corepack; install pnpm directly
# (pinned to match the root package.json's packageManager field).
RUN npm install -g pnpm@10.33.0 && addgroup -S app && adduser -S app -G app
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps ./apps
COPY packages ./packages
COPY services ./services
RUN pnpm install --frozen-lockfile --prod=false && chown -R app:app /repo
USER app
CMD ["sh", "-c", "pnpm --filter ${APP_NAME} start"]
