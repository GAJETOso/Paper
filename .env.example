# ==============================================================================
# Sylvara Platform — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env files with secrets.
# ==============================================================================

# --- Core ---------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# --- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL=postgresql://sylvara:sylvara@localhost:5432/sylvara?schema=public
DATABASE_POOL_SIZE=10

# --- Redis (cache, queues, rate limiting) -------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=change-me-64-random-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-64-random-chars
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_SECRET=change-me
TOTP_ISSUER=Sylvara

# --- OAuth providers ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Email (SMTP / transactional) ---------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Sylvara Paper Group <no-reply@sylvara.com>"
RESEND_API_KEY=

# --- WhatsApp Business Cloud API -----------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify
WHATSAPP_APP_SECRET=

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# --- AI providers --------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-5

# --- Payments ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# --- Cloud: AWS ----------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=sylvara-assets

# --- Cloud: Azure ----------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_TENANT_ID=

# --- Cloud: Google Cloud ---------------------------------------------------------
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage / CDN ---------------------------------------------------------------
STORAGE_DRIVER=s3
CDN_URL=

# --- Analytics -------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_PORT=9464

# --- ERP / CRM integrations -----------------------------------------------------
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
ORACLE_ERP_BASE_URL=
DYNAMICS_TENANT_ID=
ZOHO_CRM_TOKEN=
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# --- Search --------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
